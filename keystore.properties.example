# VaultSync Release Keystore Configuration Example
# Copy this file to 'keystore.properties' and fill in your actual production keystore details.
# DO NOT commit 'keystore.properties' or any '.jks' files to version control!

storeFile=../keystore/vaultsync-release.jks
storePassword=your_keystore_password
keyAlias=vaultsync-release
keyPassword=your_key_password
